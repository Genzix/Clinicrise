# Copy to .env on the server and fill in real values:  cp .env.example .env

# --- Required ---
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=api.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# PostgreSQL (if DB_NAME is empty, the app falls back to SQLite)
DB_NAME=clinicrise
DB_USER=clinicrise
DB_PASS=change-me
DB_HOST=localhost
DB_PORT=5432

# --- OTP login ---
# console (prints OTP to log) | fast2sms | twilio | custom_http
OTP_PROVIDER=fast2sms
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_GATEWAY_URL=

# --- Payments ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Google login / Google Business Profile ---
GOOGLE_CLIENT_ID=

# --- Optional (defaults are used if left out) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=no-reply@clinicrise.com
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# JWT_ACCESS_MINUTES=60
# JWT_REFRESH_DAYS=7
# OTP_EXPIRY_MINUTES=5
# OTP_COOLDOWN_SECONDS=60
# CLINICRISE_LEGAL_NAME=
# CLINICRISE_GST_NUMBER=
# CLINICRISE_BILLING_ADDRESS=
# CLINICRISE_BILLING_EMAIL=
